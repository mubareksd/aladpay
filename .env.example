# Public origin for metadata, sitemap, Open Graph, and checkout redirects (no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-only Alad API key — https://dashboard.alad.et/tokens
# Proxied via POST /api/alad/verify and POST /api/alad/checkout/session (never exposed to the browser).
# ALAD_API_KEY=

# Receipt OCR — https://vision.lubaak.com/docs (proxied via POST /api/vision/receipt)
# VISION_API_URL=https://vision.lubaak.com
# VISION_API_KEY=
# VISION_OCR_ENABLED=false

# PostgreSQL — guest menu & inbox (when set, replaces .data/pos-guest.json)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_SSL=false   # omit on Netlify/Vercel — SSL is inferred for remote hosts (DATABASE_SSL=true to force)

# Netlify/serverless: cPanel Postgres on a VPS IP often blocks external connections (ETIMEDOUT).
# Use Neon, Supabase, or Railway Postgres, or host the app on the same server as the database.
