# Public origin for metadata, sitemap, Open Graph, and checkout redirects (no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-only Alad API key — https://dashboard.alad.et/tokens
# Proxied via POST /api/alad/verify and POST /api/alad/checkout/session (never exposed to the browser).
# ALAD_API_KEY=

# Receipt OCR — https://vision.lubaak.com/docs (proxied via POST /api/vision/receipt)
# VISION_API_URL=https://vision.lubaak.com
# VISION_API_KEY=
# VISION_OCR_ENABLED=false

# MySQL — auth, guest menu & inbox (when set, replaces .data/pos-guest.json)
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# DATABASE_SSL=false   # set DATABASE_SSL=true if the server requires TLS

# Netlify/serverless: cPanel MySQL on a VPS IP often blocks remote port 3306 (ETIMEDOUT).
# Allow your host's IP in Remote MySQL, use a cloud database, or run the app on the same server.
